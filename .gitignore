# Archives
*.zip

# Python
**/__pycache__/**
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets
.env
.env.*

# --- Datasets: ignore all contents, keep only scripts/metadata at top level ---
app/datasets/**
!app/datasets/
!app/datasets/.gitkeep
!app/datasets/*.py
!app/datasets/*.md
!app/datasets/*.csv

# --- Pipeline artifacts (regeneratable) ---
artifacts/**

# SCALE training outputs
app/SCALE/examples/SCALE/logs/
app/SCALE/examples/SCALE/artifacts/
app/SCALE/examples/SCALE/missing_id.txt
**/checkpoints/
**/*.lmdb
**/*.lmdb-lock

# Large binary sidecars (features / media)
**/*.npy
**/*.faiss
**/*.mp4
**/*.mp3
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp

# Re-allow small repo assets if any (none today; add exceptions here if needed)
!docs/**

# Keep archive files ignored even under docs/
*.zip

# Temporary LaTeX/PDF render artifacts
.tmp_improvement_render/

# Frontend
frontend/node_modules/
frontend/dist/

# IDE / OS
.idea/
.vscode/*
!.vscode/settings.json
Thumbs.db
Desktop.ini

# Eval benchmark outputs (track only the two comparison JSON files)
output/**
!output/
!output/improvement.json
!output/non-improvement.json

# .tool
*tools/